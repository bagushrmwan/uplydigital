# Database PostgreSQL / Neon pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Session & credential encryption
SESSION_SECRET=replace-with-long-random-secret
CREDENTIAL_ENCRYPTION_KEY=replace-with-different-long-random-secret

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-admin-password

# Midtrans Production
PAYMENT_MODE=midtrans
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=true

# Setelah deploy pertama, ganti dengan URL Vercel production kamu
SITE_URL=https://nama-project.vercel.app
ALLOWED_ORIGIN=https://nama-project.vercel.app
