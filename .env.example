# Database PostgreSQL. Bisa Neon/Supabase/Postgres lain.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti-password-minimal-8-karakter

# Wajib untuk hashing/session. Isi string acak panjang (32+ karakter).
SESSION_SECRET=ganti-dengan-string-random-yang-panjang-dan-rahasia

# manual atau midtrans
PAYMENT_MODE=manual
SITE_URL=https://domain-kamu.vercel.app

# Midtrans (opsional; gunakan Sandbox dulu)
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Email otomatis via Resend (opsional)
RESEND_API_KEY=
EMAIL_FROM=Uply Digital <noreply@domain-kamu.com>

# Wajib jika menjual Top Up yang membutuhkan login akun. Minimal 32 karakter, simpan sebagai Secret.
CREDENTIAL_ENCRYPTION_KEY=ganti-dengan-secret-acak-minimal-32-karakter

# Opsional. Jika kosong, otomatis memakai SITE_URL + /api/payment-webhook
MIDTRANS_NOTIFICATION_URL=
