# ============================
# DATABASE / SECURITY
# ============================
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
SESSION_SECRET=generate-random-secret-minimum-32-chars
CREDENTIAL_ENCRYPTION_KEY=generate-a-different-random-secret-minimum-32-chars

# ============================
# ADMIN
# ============================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-admin-password

# ============================
# PAYMENT
# hybrid/multi = Midtrans + manual transfer/QRIS can appear together.
# midtrans     = Midtrans is configured, but admin switches still control storefront availability.
# manual       = manual payment only unless changed later.
# ============================
PAYMENT_MODE=hybrid
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=true

# Optional: limit Snap to specific channels IF those channels are active in your Midtrans merchant.
# Example: qris,gopay,bank_transfer
# Leave blank to let Snap use all active merchant channels.
MIDTRANS_ENABLED_PAYMENTS=

# ============================
# SITE
# ============================
SITE_URL=https://nama-project.vercel.app
ALLOWED_ORIGIN=https://nama-project.vercel.app

# ============================
# TRANSACTIONAL EMAIL KE PEMBELI (V32.1)
# ============================
# V32.1 mengirim email melalui Windows backend static IP.
# BREVO_API_KEY + sender dipindahkan ke C:\uply-backend\.env, BUKAN Vercel.
EMAIL_ENABLED=true
EMAIL_PROVIDER=windows

# Direct provider berikut hanya fallback untuk instalasi tanpa Windows backend.
# Disarankan kosongkan/hapus dari Vercel setelah Windows email relay sukses.
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM_NAME=
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=

# ============================
# BELIBAYAR VIA WINDOWS BACKEND (V31)
# BeliBayar API Key / Secret TIDAK disimpan di Vercel.
# Windows backend: https://uplyapi.duckdns.org
# Static IP whitelist BeliBayar: 168.110.211.159
# ============================
BELIBAYAR_BACKEND_URL=https://uplyapi.duckdns.org
# Nilai ini harus sama dengan UPLY_BACKEND_KEY di C:\uply-backend\.env
BELIBAYAR_BACKEND_KEY=replace-with-windows-uply-backend-key
# Set true setelah /health + QRIS/VA + inquiry Windows backend sudah lolos.
BELIBAYAR_BACKEND_READY=true

# Shared secret khusus Windows -> Vercel webhook relay.
# Nilai yang sama wajib dipasang sebagai UPLY_RELAY_KEY di Windows backend.
UPLY_RELAY_KEY=generate-random-secret-minimum-32-chars

# ============================
# DUITKU (OPTIONAL)
# ============================
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_IS_PRODUCTION=false
# Example QRIS channel. Use a code that is active for your Duitku merchant.
DUITKU_PAYMENT_METHOD=SP
